# Development defaults. Process environment values take precedence over this file.
# For a production deployment set DJANGO_ENV=production, configure real hosts,
# and supply deployment-specific credentials through a protected secret source.
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS defaults to 127.0.0.1,localhost,[::1] in development.
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Enable only behind a trusted proxy that strips client-supplied forwarded headers.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Structured logs go to stderr. Use DEBUG, INFO, WARNING, ERROR or CRITICAL.
# SMACKEND_LOG_LEVEL=INFO

POSTGRES_DB=__DATABASE_NAME__
POSTGRES_USER=smackend
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# POSTGRES_SSLMODE defaults to prefer in development and verify-full in production.
# POSTGRES_SSLROOTCERT=/path/to/postgres-ca.pem

# Pool sizes apply per Django process and database alias.
# POSTGRES_POOL_MIN_SIZE=0
# POSTGRES_POOL_MAX_SIZE=4
# POSTGRES_CONNECT_TIMEOUT_SECONDS=3
# POSTGRES_POOL_TIMEOUT_SECONDS=4
# POSTGRES_STATEMENT_TIMEOUT_MS=3000
# POSTGRES_LOCK_TIMEOUT_MS=1000
# POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

SMACKEND_AUTH_ENABLED=__SMACKEND_AUTH_ENABLED__
# SMACKEND_AUTH_SIGNUP_FIELDS=username!,password!
# SMACKEND_AUTH_PASSWORD_LOGIN=username
# SMACKEND_AUTH_OTP=
# SMACKEND_AUTH_EMAIL_VERIFICATION=none
# SMACKEND_AUTH_REQUIRE_PHONE_VERIFICATION=false
# SMACKEND_AUTH_PASSWORD_RESET=false
# SMACKEND_AUTH_ALLOW_SIGNUP=true
# SMACKEND_AUTH_SESSION_SECONDS=28800
# SMACKEND_AUTH_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMACKEND_AUTH_SMS_BACKEND=myapp.delivery.send_sms
# SMACKEND_AUTH_GOOGLE=false
# SMACKEND_AUTH_GOOGLE_CLIENT_ID=
# SMACKEND_AUTH_GOOGLE_CLIENT_SECRET=

SMACKEND_STORAGE_ENABLED=__SMACKEND_STORAGE_ENABLED__
# SMACKEND_STORAGE_BACKEND=local
# SMACKEND_STORAGE_ROOT=.smackend-media
# SMACKEND_STORAGE_FILE_BYTES=5242880
# SMACKEND_STORAGE_FILES_PER_REQUEST=4
# SMACKEND_STORAGE_QUOTA_BYTES=52428800
# SMACKEND_STORAGE_QUOTA_FILES=200
# SMACKEND_STORAGE_TYPES=png,jpeg,webp,text
# SMACKEND_STORAGE_BUCKET=
# SMACKEND_STORAGE_S3_REGION=
# SMACKEND_STORAGE_S3_ENDPOINT=

SMACKEND_ADMIN_ENABLED=__SMACKEND_ADMIN_ENABLED__

SMACKEND_HTTP_ENABLED=__SMACKEND_HTTP_ENABLED__
# SMACKEND_HTTP_PROVIDERS={"catalog":{"base_url":"https://api.example.com","credentials":{"Authorization":{"env":"CATALOG_TOKEN","prefix":"Bearer "}}}}

SMACKEND_AI_ENABLED=__SMACKEND_AI_ENABLED__
# SMACKEND_AI_DEMO_MODEL=offline
# SMACKEND_AI_MODELS={}
# SMACKEND_AI_QUOTAS={}

SMACKEND_REALTIME_ENABLED=__SMACKEND_REALTIME_ENABLED__
